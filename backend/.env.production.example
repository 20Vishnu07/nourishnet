# NourishNet Backend — Production Environment Variables (Railway)

# 1. Database Connection URL
# If using Railway Persistent Volume:
# DATABASE_URL=sqlite:////data/nourishnet.db
# If using Railway Managed PostgreSQL (Recommended):
# DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway
DATABASE_URL=sqlite:////data/nourishnet.db

# 2. CORS Allowed Origins (Comma-separated list of your Vercel frontend domains)
CORS_ORIGINS=["https://nourishnet.vercel.app","https://nourishnet-aijth.vercel.app"]

# 3. Application Secret Key for JWT Signing (Generate with: openssl rand -hex 32)
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string

# 4. Firebase Admin SDK Service Account
# In production, either mount the credentials file or provide the path to your service account key:
FIREBASE_CREDENTIALS_PATH=/etc/secrets/firebase-credentials.json
