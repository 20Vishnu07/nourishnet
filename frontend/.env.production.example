# NourishNet Frontend — Production Environment Variables (Vercel)
# Replace placeholders with your real deployment URLs and Firebase credentials

# Backend API & WebSocket (Railway deployment endpoints)
VITE_API_BASE_URL=https://nourishnet-production.up.railway.app
VITE_WS_URL=wss://nourishnet-production.up.railway.app/ws

# Firebase Web App Configuration (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=AIzaSyAExampleApiKey123456789
VITE_FIREBASE_AUTH_DOMAIN=nourishnet-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nourishnet-prod
VITE_FIREBASE_STORAGE_BUCKET=nourishnet-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456789
